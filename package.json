{
  "name": "aether-ground-station",
  "private": true,
  "version": "1.0.9",
  "description": "Aether Ground Station — modular desktop platform for ground hardware complexes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:critical": "node scripts/critical-path.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:tauri": "playwright test -c playwright.tauri.config.ts",
    "smoke:install": "powershell -ExecutionPolicy Bypass -File scripts/smoke-post-install.ps1",
    "ffmpeg:fetch": "powershell -ExecutionPolicy Bypass -File scripts/fetch-ffmpeg.ps1",
    "ffmpeg:check": "node scripts/check-ffmpeg-bundle.mjs",
    "tiles:fetch": "node scripts/fetch-offline-tiles.mjs",
    "dem:fetch": "node scripts/fetch-dem-tiles.mjs",
    "dem:fetch:copernicus": "node scripts/fetch-copernicus-dem.mjs",
    "labels:fetch": "node scripts/fetch-label-tiles.mjs",
    "pretauri:build": "node scripts/check-ffmpeg-bundle.mjs",
    "gateway:stub": "npm --prefix services/gateway-server start",
    "gateway:certs": "node scripts/gen-gateway-certs.mjs",
    "webrtc:relay": "npm --prefix services/webrtc-relay start",
    "services:install": "npm --prefix services/gateway-server install --no-fund --no-audit && npm --prefix services/webrtc-relay install --no-fund --no-audit",
    "updater:keys": "powershell -ExecutionPolicy Bypass -File scripts/gen-updater-keys.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.54.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.0.2",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
